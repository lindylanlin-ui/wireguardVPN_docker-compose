# 對外給 WireGuard client 使用的公開 IP 或 DDNS 網域。
WG_SERVER_URL=vpn.example.com

# Router 需要轉發到這台主機的 UDP port。
WG_SERVER_PORT=51820

# WireGuard 內部虛擬網段的起始子網。
# LinuxServer.io 映像使用的是「子網基底」，不是 CIDR 字串。
WG_INTERNAL_SUBNET=10.13.13.0

# 你家裡 LAN 的實體網段，主要用於文件與日後檢查。
# 因為目前採用 full tunnel，所以家中 LAN 也會一起走 WireGuard。
WG_LAN_SUBNET=192.168.4.0/24

# Peer 匯入後要使用的 DNS，可填單一 IP 或逗號分隔多組 DNS。
WG_PEER_DNS=1.1.1.1

# Full tunnel：所有 IPv4 流量都走家中 WireGuard 出口。
WG_ALLOWEDIPS=0.0.0.0/0

# 行動裝置在 NAT 後方通常建議設為 all。
WG_PERSISTENTKEEPALIVE_PEERS=all

# 實際 active peers 清單，名稱只允許英數字。
# 設成 0 代表先啟動 server，但暫時不建立任何 peer。
WG_PEERS=0

# 建立於主機上的檔案權限對應。
PUID=1000
PGID=1000
TZ=Asia/Taipei

# 是否要把 conf 內容印到 docker logs；為了安全預設關閉。
WG_LOG_CONFS=false
